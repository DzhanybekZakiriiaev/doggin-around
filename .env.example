# World Labs API key from https://platform.worldlabs.ai (API credits are separate from the Marble app)
WLT_API_KEY=

# ElevenLabs API key from https://elevenlabs.io (Scribe v2 Realtime: spoken commands for Biscuit, hold F).
# Set this in .env.local for development, or in Vercel environment variables and redeploy.
# POST /api/scribe-token mints a short-lived token. The server key never reaches the browser.
# Without it voice control stays off and the rest of the game is unaffected.
ELEVENLABS_API_KEY=
